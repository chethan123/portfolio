# Nothing reaches the build context unless the Dockerfile asks, but the
# explicit list keeps it small and secrets/node_modules impossible to include.
.git
.github
.claude
.remember
node_modules
build
.react-router
coverage
docs
tests
scripts
# ...except the one the build stage runs to trim the production tree.
!scripts/prune-unreachable-deps.mjs
*.md
LICENSE
.env
.env.*
compose.yaml
compose.dev.yaml
compose.local.yaml
compose.test.yaml
vitest.config.ts
