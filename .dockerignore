# Explicit list: keeps the context small, and secrets and node_modules impossible
# to include.
.git
.github
.claude
.remember
node_modules
build
.react-router
coverage
docs
tests
scripts
# ...except the one the build stage runs.
!scripts/prune-unreachable-deps.mjs
*.md
LICENSE
.env
.env.*
# 0700 uid 70, so for a non-root operator a build from a checkout that has ever
# run dies sending the context, before the first stage.
volumes
compose.yaml
compose.dev.yaml
compose.test.yaml
vitest.config.ts
