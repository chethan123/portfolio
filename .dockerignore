# Nothing here reaches the build context unless the Dockerfile asks for it, but
# an explicit list keeps the context small and makes accidental secret or
# node_modules inclusion impossible.
.git
.github
.claude
.remember
node_modules
build
.react-router
coverage
docs
tests
scripts
# ...except the one the build stage runs to trim the production tree.
!scripts/prune-unreachable-deps.mjs
*.md
LICENSE
.env
.env.*
compose.yaml
compose.dev.yaml
compose.test.yaml
vitest.config.ts
