# What reaches the image is the Dockerfile's COPY list and nothing else; this
# list is what cannot reach the *builder* at all. It is a denylist, so it
# names every file this checkout is told to create beside the Dockerfile that
# no build must ever see: the instance's .env, the household's allowlist, an
# operator's npm or compose overrides.
.git
.github
.claude
.agents
.remember
node_modules
build
.react-router
coverage
docs
tests
scripts
# ...except the one the build stage runs to trim the production tree.
!scripts/prune-unreachable-deps.mjs
*.md
LICENSE
.env
.env.*
# The gate's allowlist — the family's real addresses (docs/google-sign-in.md
# puts it here, beside compose.yaml).
allowed-emails.txt
.npmrc
compose.override.yaml
# The running instance's database (compose.yaml's `db-store`). Excluded for
# more than size: it is 0700 uid 70, so for a non-root operator a build from a
# checkout that has ever run dies sending the context — `error from sender: open
# volumes/db/data: permission denied` — before the first stage.
volumes
compose.yaml
compose.dev.yaml
compose.test.yaml
vitest.config.ts
# Stray diffs parked at the root (matches the root only, like every pattern
# here without `**`).
*.patch
