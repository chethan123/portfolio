# Ingress front door — DESIGN.md §10.1, compose.yaml. Plain HTTP: TLS and the
# public hostname belong to the operator's house-wide Caddy in front. Also the
# only place the gate is enforced: every request except /healthz is checked
# against the `gate` sidecar before it may reach `app`. The house proxy is
# deliberately not trusted with enforcement — a LAN device can dial this box's
# published port and land here directly.

{
	servers {
		# Without this Caddy discards the house proxy's X-Forwarded-* and tells
		# `app` every request arrived over plain HTTP from the proxy's own
		# address — ARCHITECTURE.md §2's "believed unconditionally" row, one
		# more hop out. `private_ranges`, not the proxy's address, because that
		# address is the operator's — and it is the honest bound: a LAN peer
		# can forge these headers. Affordable only because nothing below
		# decides anything on them; the gate's verdict is a session cookie it
		# decrypts itself, its redirect URL pinned in compose.yaml, never a
		# Host header.
		trusted_proxies static private_ranges
	}
}

# 8080, not 80: the pinned unprivileged uid binds a high port with no kernel
# grant. compose.yaml publishes host 80 onto it, so operator URLs are
# unchanged — the two numbers are a pair; change one, change the `ports:`
# line there too.
:8080 {
	# The one exemption: `/healthz` is read by machines, answers a pinned body,
	# carries no household data — uptime monitoring without a Google account.
	# Everything else, static assets included, is challenged.
	handle /healthz {
		reverse_proxy app:{$APP_PORT:3000}
	}

	# Sign-in, callback and sign-out belong to the sidecar, ungated. `handle`,
	# not a path matcher on `reverse_proxy`: reverse_proxy sorts after handle,
	# so a matcher would lose to the catch-all below and these paths would
	# reach `app`.
	handle /oauth2/* {
		reverse_proxy gate:4180 {
			# reverse_proxy sets X-Forwarded-{For,Proto,Host}; the sidecar also
			# wants the client address and original path for its redirects.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		forward_auth gate:4180 {
			uri /oauth2/auth

			header_up X-Real-IP {remote_host}

			# The verified address, nothing else from the gate's response.
			# `app` ignores it today — attribution for later, never permission.
			# copy_headers deletes any client-supplied value first, so a
			# browser cannot assert its own identity.
			copy_headers X-Auth-Request-Email

			# On non-2xx forward_auth copies the gate's response straight to
			# the browser, and the gate answers a bare 401 with nowhere to go
			# — so the Google handoff is built here.
			#
			# `rd` is relative on purpose: inside the stack {scheme} is `http`,
			# and the sidecar refuses absolute redirects outside its own
			# `whitelist_domains` (deliberately unset); a path is accepted
			# unconditionally and is always same-origin.
			#
			# Known limit: {uri} interpolates raw and Caddy cannot
			# percent-encode, so a target with two query parameters splits at
			# its first `&` — the visitor lands signed in, on the right screen,
			# minus the later parameters (a custom chart range comes back as
			# its start alone). Upstream's example shares the flaw; the real
			# fix hands the target over as a header — issue #92.
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /oauth2/sign_in?rd={uri}
			}
		}

		reverse_proxy app:{$APP_PORT:3000}
	}
}
