# Ingress front door — DESIGN.md §10.1. Plain HTTP: TLS and the public hostname
# belong to the house-wide Caddy in front, which is deliberately not trusted with
# enforcement — a LAN device can dial this box's published port and land here.

{
	servers {
		# Without this Caddy discards the house proxy's X-Forwarded-* and tells
		# `app` every request arrived over plain HTTP. `private_ranges` is the
		# honest bound — a LAN peer can forge these — affordable only because
		# nothing below decides anything on them (ARCHITECTURE.md §2).
		trusted_proxies static private_ranges
	}
}

# 8080, not 80: the pinned unprivileged uid binds a high port with no kernel
# grant. compose.yaml publishes host 80 onto it — change one, change both.
:8080 {
	# The one exemption: machine-read, pinned body, no household data. Everything
	# else, static assets included, is challenged.
	handle /healthz {
		reverse_proxy app:{$APP_PORT:3000}
	}

	# Ungated, and `handle` rather than a matcher on `reverse_proxy`: reverse_proxy
	# sorts after handle, so a matcher would lose to the catch-all below.
	handle /oauth2/* {
		reverse_proxy gate:4180 {
			# On top of the X-Forwarded-* reverse_proxy already sets.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		forward_auth gate:4180 {
			uri /oauth2/auth

			header_up X-Real-IP {remote_host}

			# The verified address, nothing else. copy_headers deletes any
			# client-supplied value first, so a browser cannot assert its own.
			copy_headers X-Auth-Request-Email

			# On non-2xx forward_auth copies the gate's response to the browser,
			# and the gate answers a bare 401 — so build the handoff here. `rd`
			# is relative on purpose: the sidecar refuses absolute redirects
			# outside `whitelist_domains` (unset), a path is always same-origin.
			# Known limit: {uri} interpolates raw and Caddy cannot percent-encode,
			# so a target with two query parameters splits at its first `&` — #92.
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /oauth2/sign_in?rd={uri}
			}
		}

		reverse_proxy app:{$APP_PORT:3000}
	}
}
