# Portfolio Tracker — the complete configuration surface (DESIGN.md §10.1).
# All validated at startup: a bad value stops the container naming the variable.
#
#     cp .env.example .env


# Required — no defaults; `up` refuses until set (DUMP_UID/GID below too).

# The https:// origin your house-wide Caddy serves this at, in exact canonical
# form — no trailing slash, path, upper case or default port. The gate's redirect
# URI and the lock's relying-party id (ADR-0012) compare it verbatim, so: a real
# domain, never an IP. `http://localhost` for the dev loop.
PUBLIC_ORIGIN=https://portfolio.example.com

# The gate (oauth2-proxy) — docs/google-sign-in.md. The redirect URI registered
# on the OAuth client is PUBLIC_ORIGIN + /oauth2/callback.
GATE_CLIENT_ID=
GATE_CLIENT_SECRET=

# Session-cookie key; must decode to 16, 24 or 32 bytes, or the gate won't start:
# `openssl rand -base64 32 | tr -- '+/' '-_'`. Rotating signs every device out.
GATE_COOKIE_SECRET=

# Who may enter is ./allowed-emails.txt beside this file, not a variable — copy
# allowed-emails.example.txt. `up` fails if it is missing.

# Seeds the `portfolio` role at initdb, then serves as `app`/`dump`'s PGPASSWORD:
# `openssl rand -hex 32`. Changing it on a running instance takes more than this
# line (docs/operating.md). Still required under compose.external-db.yaml.
POSTGRES_PASSWORD=


# Optional — defaults shown.

# Unset uses the bundled `db`; read compose.external-db.yaml's header before
# setting it. A password written into the URL wins over PGPASSWORD.
#DATABASE_URL=postgres://portfolio:secret@postgres.lan:5432/portfolio

# Changes one thing, the "unprotected instance" warning. The app authenticates nobody.
#AUTH_GATE=none

# HTTP listen port — `caddy` reads it too. TLS ends at the house-wide Caddy.
#PORT=3000

# Refresh cadence lives at Settings → Prices now; PRICE_POLL_INTERVAL_MINUTES is ignored.

# Max statement upload, whole mebibytes, minimum 1.
#MAX_UPLOAD_MB=10

# IANA zone: whether the market is open, and which trading day a quote belongs to
# — UTC would file an evening mutual-fund NAV a day late. Storage stays UTC.
#MARKET_TIMEZONE=America/New_York

# Container clock; log lines only.
#TZ=UTC

# Only for a worker run outside Compose — spec 0018 §3.2.
#PRICE_WORKER_SOCKET=/run/price-worker/worker.sock


# The nightly dump (ADR-0009) — read by the sidecar's own script, not
# server/config.ts, so a bad value stops that container and nothing else.

# Required, no default: the account owning ./volumes/dumps — your own, `id -u`
# and `id -g`. Not 1000, which is `app`'s uid, and shared uids share bind-mount
# rights. Blank on purpose — copying this file must not hand you someone else's.
DUMP_UID=
DUMP_GID=

# false exits 0 and stays exited, so bare `docker compose ps` won't list it.
#DUMP_ENABLED=true

# UTC hour, two digits — UTC whatever TZ says.
#DUMP_AT=02

# A hand-off window, not your history: how long your backup tool can be broken.
#DUMP_KEEP_DAYS=7

# 0-9, or `none`. Uncompressed by default so a deduplicating backup tool sees a
# stable byte stream. The run refuses rather than filling the database's disk.
#DUMP_COMPRESS=0

# `1` floats with every v1.x.y; pin a full version to hold still or roll back.
#APP_VERSION=1
