# Portfolio Tracker — the complete configuration surface.
#
# Every setting the application has is an environment variable and every one of
# them is listed below (DESIGN.md §10.1). Nothing is configured in a file, a
# database row or a UI toggle; if it is not here, it is not configurable.
#
# All of them are validated once at startup. A missing or malformed value stops
# the container immediately with a message naming the variable, rather than
# failing hours later on the request that happens to need it.
#
# Compose supplies working defaults for everything except DATABASE_URL, which it
# points at its own `db` service. Copy this file to `.env` only to change
# something:
#
#     cp .env.example .env


# --- Required -----------------------------------------------------------------

# Postgres connection string. Under Compose this defaults to the bundled `db`
# service and you do not need to set it. Set it to run against your own Postgres.
DATABASE_URL=postgres://portfolio:portfolio@db:5432/portfolio


# --- Optional: authentication -------------------------------------------------

# Setting AUTH_PASSWORD turns on the login gate: one password, one signed
# cookie, one login page. Leave it unset and the instance is open to anyone who
# can reach it — the UI shows a persistent warning banner while that is true.
# There is no user account and no registration; this is not multi-user auth.
#AUTH_PASSWORD=

# Cookie signing key. Required as soon as AUTH_PASSWORD is set, and startup
# fails naming this variable if you set one without the other. Use a long random
# string, for example: openssl rand -hex 32
#SESSION_SECRET=


# --- Optional: everything else ------------------------------------------------

# HTTP listen port. Under Compose this is also the published host port, so
# changing it here moves both. The app serves plain HTTP: TLS termination is
# your reverse proxy's job, and note that without HTTPS in front, phones cannot
# install this as a PWA (a service worker needs a secure context).
#PORT=3000

# How often quotes are refreshed, in minutes, between 1 and 1440. Validated from
# this release onward so the configuration surface is stable, but nothing reads
# it until the pricing slice ships.
#PRICE_POLL_INTERVAL_MINUTES=15

# IANA time zone used only to decide whether the market is open. It has no
# effect on storage. Validated but unread until the pricing slice ships.
#MARKET_TIMEZONE=America/New_York

# Container clock. The database stores UTC whatever you set here, so changing it
# only affects how the app's own log lines read. Leaving it at UTC is strongly
# recommended: it is what makes a stored timestamp unambiguous.
#TZ=UTC


# --- Compose-level, not application settings ----------------------------------
#
# These configure compose.yaml rather than the app, which is why they are not in
# the table above. The database port is not published to the host, so this
# password never leaves the Compose network. If you change it, change the
# password in DATABASE_URL to match.
#POSTGRES_PASSWORD=portfolio
