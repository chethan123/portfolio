# Portfolio Tracker — the complete configuration surface.
#
# Every deployment setting is an environment variable listed below
# (DESIGN.md §10.1), with one exception: who is allowed in is a flat file of
# addresses (gate section), because it is a list that grows. If it is not
# here, an operator cannot change it. The one non-deployment setting — the
# household's capital gains rate — is a database row edited at Settings → Tax
# (DESIGN.md §8.4): the household's figure, not the operator's, moving more
# often than a container is rebuilt.
#
# All validated once at startup: a bad value stops the container naming the
# variable, rather than failing hours later on the request that needs it.
# Compose supplies working defaults for everything except the gate section,
# which has none by design — a half-configured instance can never boot open.
#
#     cp .env.example .env


# --- Required -----------------------------------------------------------------

# Postgres connection string. The Compose default (the bundled `db` service)
# just works; set it to run against your own Postgres.
DATABASE_URL=postgres://portfolio:portfolio@db:5432/portfolio


# --- Required: the gate -------------------------------------------------------
#
# The `gate` service (oauth2-proxy): admits nobody not signed in with Google
# as an allowlisted address. Nothing starts until all are set — compose names
# the missing one rather than bring up an open instance.
#
# Where the values come from: docs/google-sign-in.md, walked once per
# instance — Google Cloud project, consent screen, OAuth client, and its one
# redirect URI (PUBLIC_ORIGIN + /oauth2/callback), which Google matches
# character for character.

GATE_CLIENT_ID=
GATE_CLIENT_SECRET=

# Session-cookie encryption key; must decode to exactly 16, 24 or 32 bytes or
# oauth2-proxy refuses to start. Generate:
#
#     openssl rand -base64 32 | tr -- '+/' '-_'
#
# Rotating signs everyone out on every device at once — the blunt revocation
# lever (docs/operating.md); the per-person one is the allowlist.
GATE_COOKIE_SECRET=

# The https:// origin your house-wide Caddy serves this at, no trailing slash.
# The gate builds its Google redirect URL from it; Google redirects the
# *browser*, so it only needs to be reachable from the family's LAN or VPN.
PUBLIC_ORIGIN=https://portfolio.example.com

# Who may enter is ./allowed-emails.txt beside this file — one Google address
# per line, mounted read-only into the gate; copy allowed-emails.example.txt.
# `docker compose up` fails if it is missing, like the variables above.
# Membership changes: docs/google-sign-in.md; what removal actually revokes:
# docs/operating.md.


# --- Optional: what fronts the app --------------------------------------------

# Whether something in front authenticates the request. `external` = a gate
# does (what compose.yaml sets — the `gate` service is right there); `none`,
# the default, is a bare `npm run dev`. Changes exactly one thing: the
# persistent "unprotected instance" warning. The app authenticates nobody
# either way — `external` protects nothing, it only stops the app crying wolf
# behind a gate that is genuinely there.
#AUTH_GATE=none


# --- Optional: everything else ------------------------------------------------

# HTTP listen port. Under Compose only the bundled `caddy` faces the host, and
# it reads this same variable; everything inside speaks plain HTTP. TLS ends
# at the house-wide Caddy at PUBLIC_ORIGIN — also the secure context the
# service worker needs, so the instance installs as an app there and nowhere
# else (docs/operating.md, "Installing on a phone").
#PORT=3000

# Refresh cadence is not here: the household's dial, set at Settings → Prices,
# stored beside the capital gains rate. (PRICE_POLL_INTERVAL_MINUTES is now
# ignored — re-enter the value once on that screen.)

# Max statement upload, whole mebibytes, minimum 1. A brokerage CSV is tens of
# kilobytes — the default bounds accidents, not real statements.
#MAX_UPLOAD_MB=10

# IANA zone for two things: whether the market is open, and which trading day
# a quote's own timestamp belongs to. The second picks the date a daily close
# is stored under — UTC here would file an evening mutual-fund NAV a day late.
# Storage stays UTC regardless.
#MARKET_TIMEZONE=America/New_York

# Container clock. Storage is UTC whatever this says; only log lines change.
# Keep UTC — it is what makes a stored timestamp unambiguous.
#TZ=UTC


# --- Compose-level, not application settings ----------------------------------
#
# The database port is not published, so this password never leaves the
# Compose network. Change it = change DATABASE_URL's password to match.
#POSTGRES_PASSWORD=portfolio

# Which published image tag `app` runs. `1` floats with every v1.x.y release;
# pin a full version (`1.0.3`) to hold still or return to a known-good image —
# the rollback's "old image" half (docs/operating.md), and why this is a
# variable rather than a compose.yaml edit mid-incident.
#APP_VERSION=1
