# Portfolio Tracker — the complete configuration surface.
#
# Every setting the deployment has is an environment variable and every one of
# them is listed below (DESIGN.md §10.1), with one exception named in the gate
# section: who is allowed in is a flat file of addresses rather than a variable,
# because it is a list that grows. Otherwise, if it is not here, an operator
# cannot change it.
#
# There is one setting that is not a deployment setting, and so is not here: the
# household's capital gains rate, which the Analysis screen estimates with. It
# is a row in the database, edited at Settings → Tax (DESIGN.md §8.4), because
# it is the household's own figure rather than the operator's and it moves more
# often than a container is rebuilt.
#
# All of them are validated once at startup. A missing or malformed value stops
# the container immediately with a message naming the variable, rather than
# failing hours later on the request that happens to need it.
#
# Compose supplies working defaults for everything except the gate section
# below, which has none by design: `docker compose up` refuses to start until
# those four exist, so a half-configured instance can never boot open. Copy this
# file to `.env` and fill them in:
#
#     cp .env.example .env


# --- Required -----------------------------------------------------------------

# Postgres connection string. Under Compose this defaults to the bundled `db`
# service and you do not need to set it. Set it to run against your own Postgres.
DATABASE_URL=postgres://portfolio:portfolio@db:5432/portfolio


# --- Required: the gate -------------------------------------------------------
#
# These four configure the `gate` service (oauth2-proxy), which sits in front of
# the app and admits nobody who has not signed in with Google as an address on
# the allowlist. Nothing starts until all four are set: compose stops and names
# the one that is missing rather than bringing up an open instance.
#
# One-time Google setup, done once per instance:
#
#   1. console.cloud.google.com → APIs & Services → OAuth consent screen.
#      Pick "External", fill in the app name and your own email, and publish it.
#      The gate asks only for the `profile` and `email` scopes, so no
#      verification review is needed. Publishing it means any Google account can
#      reach the account picker — the allowlist below is what refuses them, and
#      that is the whole authorization story.
#   2. Credentials → Create credentials → OAuth client ID → Web application.
#   3. Add one Authorized redirect URI: PUBLIC_ORIGIN + /oauth2/callback, e.g.
#      https://portfolio.example.com/oauth2/callback — character for character,
#      or Google refuses the sign-in.
#   4. Copy the client ID and client secret into the two variables below.

GATE_CLIENT_ID=
GATE_CLIENT_SECRET=

# Encryption key for the gate's session cookie. Must decode to exactly 16, 24 or
# 32 bytes — oauth2-proxy builds an AES cipher from it and refuses to start
# otherwise. Generate one:
#
#     openssl rand -base64 32 | tr -- '+/' '-_'
#
# Rotating this signs everyone out on every device at once, which is the blunt
# revocation lever (docs/operating.md); the per-person one is the allowlist.
GATE_COOKIE_SECRET=

# The https:// origin your house-wide Caddy serves this instance at, with no
# trailing slash. The gate builds its Google redirect URL from it, and Google
# redirects the browser — not its own servers — so this only has to be reachable
# from the LAN or VPN the family is on.
PUBLIC_ORIGIN=https://portfolio.example.com

# Who may enter is not a variable: it is ./allowed-emails.txt beside this file,
# one Google address per line, mounted read-only into the gate. Copy
# allowed-emails.example.txt to it. `docker compose up` fails if it is missing,
# the same way it fails on the variables above.


# --- Optional: what fronts the app --------------------------------------------

# Whether something in front of the app authenticates the request. `external`
# means a gate does — which is what compose.yaml sets, because the `gate`
# service is right there. `none`, the default, is what a developer running
# `npm run dev` has.
#
# It changes exactly one thing: whether the UI shows its persistent "unprotected
# instance" warning. The app authenticates nobody either way, and setting this
# to `external` protects nothing — it only stops the app crying wolf behind a
# gate that is genuinely there.
#AUTH_GATE=none


# --- Optional: everything else ------------------------------------------------

# HTTP listen port. Under Compose the app is not published to the host at
# all — the bundled `caddy` service is the only container reachable from
# outside, and it is told this port via the same variable. Everything inside
# the stack speaks plain HTTP; TLS is terminated by the house-wide Caddy at
# PUBLIC_ORIGIN, which is also what supplies the secure context a service
# worker will need once the PWA slice is built. Nothing is installable yet:
# the app ships no manifest and no service worker.
#PORT=3000

# How often quotes are refreshed is not here: the refresh cadence is the
# household's dial rather than the deployment's, so it is set at
# Settings → Prices and stored in the database beside the capital gains rate.
# (Older checkouts configured PRICE_POLL_INTERVAL_MINUTES; the variable is now
# ignored — re-enter the value once on that screen.)

# The most a statement upload may carry, in whole megabytes, minimum 1. A
# brokerage CSV is tens of kilobytes, so the default bounds what an accident
# can put in memory rather than anything a real statement needs.
#MAX_UPLOAD_MB=10

# IANA time zone for two things: deciding whether the market is open, and
# reading a quote's own timestamp to work out which trading day it belongs to.
# The second one matters — it picks the date a daily close is stored under, so
# changing this to UTC would file an evening mutual-fund NAV a day late. It has
# no effect on how timestamps are stored, which is UTC regardless.
#MARKET_TIMEZONE=America/New_York

# Container clock. The database stores UTC whatever you set here, so changing it
# only affects how the app's own log lines read. Leaving it at UTC is strongly
# recommended: it is what makes a stored timestamp unambiguous.
#TZ=UTC


# --- Compose-level, not application settings ----------------------------------
#
# These configure compose.yaml rather than the app. The database port is not
# published to the host, so this password never leaves the Compose network. If
# you change it, change the password in DATABASE_URL to match.
#POSTGRES_PASSWORD=portfolio

# Which published image tag the `app` service runs. `1` is the floating major:
# it follows every v1.x.y release, so `docker compose up -d` picks up the newest
# one. Pin a full version — `1.0.3` — to hold an instance where it is, or to go
# back to a known-good image after a bad upgrade. That is the "old image" half of
# the rollback in docs/operating.md, and the reason this is a variable rather
# than a line in compose.yaml you would have to edit mid-incident.
#APP_VERSION=1
